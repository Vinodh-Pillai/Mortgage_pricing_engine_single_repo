{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExceptionError",
  "type": "object",
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Deterministic error code"
    },
    "message": {
      "type": "string",
      "description": "Human-readable error message"
    },
    "requestId": {
      "type": "string",
      "description": "Exception request id if applicable"
    }
  },
  "additionalProperties": false
}
