# Keep text checkouts stable across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows command files should keep CRLF for native Windows execution.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never be line-ending normalized.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.war binary
*.gz binary
*.tgz binary
