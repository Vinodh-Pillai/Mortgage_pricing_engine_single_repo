{
  "name": "pricing-workbench-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom src",
    "test:watch": "vitest --environment jsdom",
    "test:evidence": "vitest run --environment jsdom src/lib/evidence",
    "test:i18n": "vitest run --environment jsdom src/lib/i18n",
    "harness:validate-evidence": "vitest run --environment jsdom src/lib/evidence/evidence.test.tsx",
    "test:data-layer": "vitest run --environment jsdom src/lib/data",
    "test:routing": "vitest run --environment jsdom src/routing",
    "test:auth": "vitest run --environment jsdom src/lib/auth src/routing/RouteGuard.test.tsx src/layout/navigation-auth.test.ts",
    "test:login": "vitest run --environment jsdom src/screens/auth/LoginScreen.test.tsx",
    "test:layout": "vitest run --environment jsdom src/layout",
    "test:design-system": "vitest run --environment jsdom src/design-system",
    "test:screens": "vitest run --environment jsdom src/screens/shared/PageStateWrapper.test.tsx src/screens/FunctionalityScreens.test.tsx src/routing/routes.test.tsx src/layout/navigation-auth.test.ts",
    "test:quote-intake": "vitest run --environment jsdom src/screens/quoteIntake",
    "test:compliance-evidence": "vitest run --environment jsdom src/screens/complianceEvidence/ComplianceEvidenceScreen.test.tsx",
    "lint:design-tokens": "vitest run --environment jsdom src/design-system/tokens.test.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --project=demo-headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report tests/results/html-report",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:baseline:update": "playwright test tests/e2e/visual --update-snapshots",
    "e2e:drift:check": "node tests/e2e/core/drift/drift-checker.mjs",
    "e2e:drift:baseline": "node tests/e2e/core/drift/baseline-capture.mjs",
    "e2e:pii25": "playwright test tests/e2e/auth/login.test.ts tests/e2e/navigation/navigation.test.ts tests/e2e/quote-intake/quote-intake.test.ts tests/e2e/tenant/tenant-onboarding.test.ts tests/e2e/product/product-management.test.ts tests/e2e/ratesheet/rate-sheet-intake.test.ts tests/e2e/pricing/pricing-analysis.test.ts tests/e2e/locks/lock-management.test.ts tests/e2e/visual tests/e2e/a11y/a11y.test.ts tests/e2e/persona/persona-matrix.test.ts --project=chromium --project=firefox --project=webkit --workers=1",
    "e2e:visual": "playwright test tests/e2e/visual",
    "e2e:a11y": "playwright test tests/e2e/a11y/a11y.test.ts",
    "e2e:demo": "npm run e2e:headed -- --grep @demo",
    "e2e:login": "playwright test tests/e2e/auth/login.test.ts",
    "e2e:quote-intake": "playwright test tests/e2e/quote-intake/quote-intake.test.ts",
    "e2e:screens": "playwright test tests/e2e/screens/functionality-pages.test.ts",
    "e2e:full": "npm run e2e -- --workers=4",
    "e2e:ci": "npm run e2e -- --workers=2 --retries=2",
    "test:all": "npm run test && npm run e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-query-devtools": "^5.80.7",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^6.26.2",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.47.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^25.9.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.12.1",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "jsdom": "latest",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.47.0",
    "pngjs": "^7.0.0",
    "vitest": "latest"
  }
}
